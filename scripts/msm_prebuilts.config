# The common kernel is built by scripts/build_common.sh.  Reuse that dist tree
# instead of asking the Qualcomm build config to launch a nested common build.
export GKI_BUILD_CONFIG=""
export GKI_PREBUILTS_DIR="${GKI_DIST_DIR:?GKI_DIST_DIR is required}"

# GKI_PREBUILTS_DIR is the single mixed-build input. Leaving GKI_DIST_DIR set
# would make build/build.sh copy the same GKI artifacts into DIST_DIR again at
# the end of the MSM build.
unset GKI_OUT_DIR GKI_DIST_DIR
