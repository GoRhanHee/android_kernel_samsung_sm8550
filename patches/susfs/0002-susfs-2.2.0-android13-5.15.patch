+	do {
+		seq = read_seqbegin(&susfs_fake_cmdline_or_bootconfig_seqlock);
+		seq_puts(m, fake_cmdline_or_bootconfig);
+	} while (read_seqretry(&susfs_fake_cmdline_or_bootconfig_seqlock, seq));
+}
